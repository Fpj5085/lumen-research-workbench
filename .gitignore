# manifest; docs/screenshots/ holds only the curated demo captures.
qa/results/
qa/test-results/
qa/playwright-report/
qa/node_modules/
# Reviewer-only audit toolchain virtualenv (public pip-audit, never published).
qa/.audit-venv/

